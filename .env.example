# Configuração da API do Google Gemini
GEMINI_API_KEY=sua_chave_api_gemini_aqui
GEMINI_MODEL=gemini-2.5-pro
# Configurações de resiliência
MAX_RETRIES=15
RETRY_DELAY=5
BACKOFF_MAX=300
# Duração dos segmentos (em minutos)
SEGMENT_DURATION_MINUTES=15
# Modelos fallback (ordem de preferência)
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3.1-flash-lite-preview,gemini-2.5-pro,gemini-2.0-flash,gemini-1.5-pro,gemini-1.5-flash,gemini-1.5-flash-8b